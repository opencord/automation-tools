# This Dockerfile is used to build an webserver that contains all the ONOS applications
# used in SEBA 1.0.0.
#
# You can build this image using this command:
# docker build -t opencord/mavenrepo:seba-1.0.0 -f Dockerfile.onos-apps.seba-1.0.0 .
#
# And install it using the mavenrepo helm-chart, such as: (note that you'll need to push the image to the docker registry on the pod)
# helm install -n mavenrepo mavenrepo --set image.repository=<cluster-ip>:30500/opencord/mavenrepo --set image.tag=seba-1.0.0
#
# Once the container is deployed, your ONOS applications are available at:
# <cluster-ip>:30160/repository/
#
# You can then use this values:
# seba-services:
#   oltAppUrl: http://192.168.0.100:30160/repository/olt.oar
#   sadisAppUrl: http://192.168.0.100:30160/repository/sadis.oar
#   dhcpL2RelayAppUrl: http://192.168.0.100:30160/repository/dhcpl2relay.oar
#   aaaAppUrl: http://192.168.0.100:30160/repository/aaa.oar
#   kafkaAppUrl: http://192.168.0.100:30160/repository/kafka.oar

FROM jrelva/nginx-autoindex
RUN mkdir -p /usr/share/nginx/html/repository
WORKDIR /usr/share/nginx/html/repository

RUN apt-get update && apt-get install curl -y

RUN curl -L "https://oss.sonatype.org/service/local/repositories/releases/content/org/opencord/olt-app/2.1.0/olt-app-2.1.0.oar" > olt.oar
RUN curl -L "https://oss.sonatype.org/service/local/repositories/releases/content/org/opencord/sadis-app/2.2.0/sadis-app-2.2.0.oar" > sadis.oar
RUN curl -L "https://oss.sonatype.org/service/local/repositories/releases/content/org/opencord/dhcpl2relay/1.5.0/dhcpl2relay-1.5.0.oar" > dhcpl2relay.oar
RUN curl -L "https://oss.sonatype.org/service/local/repositories/releases/content/org/opencord/aaa/1.8.0/aaa-1.8.0.oar" > aaa.oar
RUN curl -L "https://oss.sonatype.org/service/local/repositories/releases/content/org/opencord/kafka/1.0.0/kafka-1.0.0.oar" > kafka.oar

RUN chown nginx:nginx -R /usr/share/nginx/html/repository